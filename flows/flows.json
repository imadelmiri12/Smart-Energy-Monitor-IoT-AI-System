    {
        "id": "58ec8538aeb8ae3d",
        "type": "function",
        "z": "68622e53a20bfeac",
        "name": "Plus gros consommateur",
        "func": "let appareils = {\n    \"Lampe\": msg.payload.lamp,\n    \"TV\": msg.payload.tv,\n    \"Ventilo\": msg.payload.fan,\n    \"PC\": msg.payload.pc,\n    \"Climatisation\": msg.payload.ac,\n    \"Machine\": msg.payload.wm\n};\n\nlet maxNom = \"\";\nlet maxVal = -1;\n\nfor (let nom in appareils) {\n    if (appareils[nom] > maxVal) {\n        maxVal = appareils[nom];\n        maxNom = nom;\n    }\n}\n\nmsg.payload =  maxNom + \" : \" + maxVal + \" W\";\n\nreturn msg;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
